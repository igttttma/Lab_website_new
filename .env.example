ADMIN_PASSWORD=change-me-before-deploying
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_LOCKOUT_MS=600000
TRUST_PROXY=false
HOST=127.0.0.1
PORT=4173
API_PORT=4174
SECURE_COOKIES=false

# BlimpMate browser-safe Agent Lab bridge
BLIMPMATE_AGENT_URL=http://127.0.0.1:5050
BLIMPMATE_AGENT_TIMEOUT_MS=3500
BLIMPMATE_AGENT_MAX_REQUEST_BYTES=8500000
BLIMPMATE_AGENT_DEMO_FALLBACK=true
# Optional only when the browser can reach the Flask service directly and CORS is configured:
# VITE_BLIMPMATE_AGENT_DIRECT_URL=http://127.0.0.1:5050
# VITE_BLIMPMATE_AGENT_TIMEOUT_MS=5000
